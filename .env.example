# Địa chỉ mà dashboard lắng nghe (mặc định: 0.0.0.0)
HOST=0.0.0.0

# Cổng chạy dashboard (mặc định: 8080)
PORT=8080

# Mật khẩu đăng nhập dashboard
DASHBOARD_PASSWORD=your-dashboard-password

# Khóa bí mật dùng để ký JWT; hãy dùng một chuỗi ngẫu nhiên đủ dài
JWT_SECRET=your-jwt-secret

# Thuật toán ký JWT (mặc định: HS256)
JWT_ALGORITHM=HS256

# Thời gian hiệu lực của JWT tính bằng giờ (mặc định: 72)
JWT_EXPIRE_HOURS=72

# Tên file chứa token Discord (mặc định: tokens.txt)
TOKENS_FILE=tokens.txt

# Bật đường hầm Cloudflare: true hoặc false (mặc định: true)
ENABLE_TUNNEL=true

# Đường dẫn tới chương trình cloudflared
CLOUDFLARED_PATH=/usr/local/bin/cloudflared

# Discord ID được phép dùng lệnh <!nội dung> để mọi tài khoản nhắc lại; để trống là tắt
OWNER_ID=
